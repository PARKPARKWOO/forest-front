{
  "name": "cms-react-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tailwind:init": "tailwindcss init -p",
    "draft": "vite --host 127.0.0.1 --mode draft",
    "test:unit:organization": "node --test tests/unit/organization*.test.js",
    "test:unit:design-system": "node --test src/design-system/tests/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js src/design-system/tests/*.test.js",
    "draft:organization": "vite --host 127.0.0.1 --mode organization-e2e",
    "draft:organization-preview": "VERCEL_ENV=preview vite --host 127.0.0.1",
    "test:e2e:organization": "playwright test --config=playwright.organization.config.js",
    "test:e2e:organization:preview": "FOREST_E2E_PREVIEW=true playwright test --config=playwright.organization.config.js tests/e2e/organization-directory-admin.spec.js",
    "test:e2e:public": "playwright test tests/e2e/public-home.spec.js tests/e2e/public-home-states.spec.js",
    "test:e2e:public:functional": "playwright test tests/e2e/public-home.spec.js tests/e2e/public-home-states.spec.js --grep-invert 'reviewed responsive baseline'",
    "test:e2e:design-system": "playwright test tests/e2e/design-system-catalog.spec.js tests/e2e/home-hero-parity.spec.js",
    "test:e2e:public:update": "playwright test tests/e2e/public-home.spec.js --update-snapshots",
    "preview:built": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e:built": "playwright test --config=playwright.built.config.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.71.10",
    "axios": "^1.8.4",
    "dompurify": "^3.4.12",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.4.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.17",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^6.2.0"
  }
}
